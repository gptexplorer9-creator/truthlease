{
  "name": "truthlease",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Approval-gated recall containment on the TrueForge agent harness.",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:ui",
    "build:ui": "tsc -p tsconfig.ui.json",
    "check": "npm run build && npm test",
    "dev": "tsx watch src/server.ts",
    "evidence:direct-dev": "tsx scripts/live-evidence.ts",
    "evidence:verify": "tsx scripts/verify-trueforge-session.ts",
    "start": "node dist/src/server.js",
    "state:reset": "tsx scripts/reset-state.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "trueforge": "npx --yes @truefoundry/trueforge@0.1.4 --port 8790"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.2.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.4.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
