# The owned MCP server binds to loopback only.
TRUTHLEASE_PORT=8787
TRUTHLEASE_HOST=127.0.0.1

# TrueForge configuration is completed in its local UI and persisted in its
# local database. Never put model or connector credentials in this repository.
TRUEFORGE_BASE_URL=http://127.0.0.1:8790
TRUTHLEASE_TRUEFORGE_URL=http://127.0.0.1:8790
TRUTHLEASE_TRUEFORGE_SESSION_ID=
TRUTHLEASE_MODEL=openai/gpt-5-6-sol

# Hosted append-only ledger and outbound operator connector. Keep all real
# values in ignored local/Vercel environments, never in this file.
DATABASE_URL=
TRUTHLEASE_BASE_URL=https://your-truthlease-deployment.vercel.app
TRUTHLEASE_CONNECTOR_ID=local-trueforge
TRUTHLEASE_CONNECTOR_TOKEN=
TRUTHLEASE_INGESTION_TOKEN=
TRUTHLEASE_CONNECTOR_ATTESTATION_SECRET=
TRUTHLEASE_CONNECTOR_ATTESTATION_KEY_ID=
TRUTHLEASE_CASE_ID=TL-042
TRUTHLEASE_RUN_ID=
TRUEFORGE_LOOPBACK_URL=http://127.0.0.1:8790
