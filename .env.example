# The owned MCP server binds to loopback only.
TRUTHLEASE_PORT=8787
TRUTHLEASE_HOST=127.0.0.1

# TrueForge configuration is completed in its local UI and persisted in its
# local database. Never put model or connector credentials in this repository.
TRUEFORGE_BASE_URL=http://127.0.0.1:8790
TRUTHLEASE_TRUEFORGE_URL=http://127.0.0.1:8790
TRUTHLEASE_TRUEFORGE_SESSION_ID=
TRUTHLEASE_MODEL=openai/gpt-5-6-sol
